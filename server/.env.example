# ==========================================
# Copy this file to .env and adjust values
#   Windows: copy .env.example .env
#   mac/Linux: cp .env.example .env
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection (local instance, or Atlas for production)
MONGO_URI=mongodb://localhost:27017/Atr_Resturant

# Admin Secret Code for Dashboard Access
ADMIN_SECRET_CODE=ADMIN2024

# Frontend URLs (CORS). Localhost is already allowed on any port,
# so these are optional locally. Set them for production deploys.
# CLIENT_URL=https://your-client-app.vercel.app
# ADMIN_URL=https://your-admin-dashboard.vercel.app

NODE_ENV=development
